<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="upcoming"
            android:textSize="12sp"
            android:textStyle="normal"
            android:letterSpacing="0.0"
            android:textColor="#B3FFFFFF" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="0 pending"
            android:textSize="11sp"
            android:textColor="#CCCCCC"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Checklist List View -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_marginBottom="8dp" />

    <!-- Centered Empty State Text View if list is empty -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No tasks piled up. Enjoy the peace!"
        android:textColor="#888888"
        android:textSize="13sp"
        android:textStyle="italic"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="10dp" />

    <!-- Action Buttons with clean Icons instead of emoji text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Type Input Action -->
        <LinearLayout
            android:id="@+id/btn_widget_type"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:gravity="center"
            android:layout_marginRight="4dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/btn_widget_type_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pencil_widget"
                android:contentDescription="Type notes" />
        </LinearLayout>

        <!-- Record Mic Action -->
        <LinearLayout
            android:id="@+id/btn_widget_record"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_primary"
            android:gravity="center"
            android:layout_marginLeft="4dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/btn_widget_record_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_mic_widget"
                android:contentDescription="Record thought" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
